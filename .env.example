# Anthropic API key used server-side only (never exposed to the browser).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API key, server-side only. Required only for agents whose skills/*.md
# frontmatter sets `provider: openai` (default provider is anthropic — see CLAUDE.md).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OmniRoute — free, self-hosted, MIT-licensed multi-provider LLM gateway (see docker-compose.yml).
# Required only for agents whose skills/*.md frontmatter sets `provider: omniroute`.
# Local dev (omniroute run separately, e.g. `npx omniroute` or its own docker container):
#   OMNIROUTE_BASE_URL=http://localhost:20128/v1
# Docker deployment (this repo's docker-compose.yml omniroute service, same network):
#   OMNIROUTE_BASE_URL=http://omniroute:20128/v1
OMNIROUTE_BASE_URL=
# Only needed once auth is turned on for your OmniRoute instance (Dashboard → Endpoints).
# Leave empty to use OmniRoute's built-in keyless free providers.
OMNIROUTE_API_KEY=
# Docker deployment ONLY (docker-compose.yml's omniroute service reads this via env_file).
# A fresh OmniRoute instance has NO password at all until first-time setup completes —
# whoever reaches its dashboard first can claim admin. Set this before first `docker
# compose up` so it boots already locked down. (This is also why docker-compose.yml
# does not publish omniroute's port to the host — reach it via an SSH tunnel instead:
# `ssh -L 20128:localhost:20128 <user>@<host>`, then browse http://localhost:20128.)
INITIAL_PASSWORD=

# Signs the per-user session cookie (lib/auth/session.ts). If unset, the auth gate is
# skipped entirely (so local dev without a .env stays usable) — set it to protect a
# public deployment. Any long random string works.
SESSION_SECRET=

# Bootstrap super-admin: the first signup using this exact email self-approves and is
# marked is_super_admin (see app/api/auth/signup/route.ts) instead of going through the
# normal pending/approval flow — everyone else who signs up needs Hadar's approval at
# /admin/users.
SUPER_ADMIN_EMAIL=hadar.loss@gmail.com

# Retired: the old single-shared-account model (APP_USERNAME/APP_PASSWORD HTTP-Basic-like
# gate) has been replaced by per-user signup + approval above. Neither proxy.ts nor the
# login route reads these anymore — safe to delete if you have them set from before.
